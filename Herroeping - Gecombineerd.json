    "en_GB": {
      "name": "Withdrawal - Combined",
      "submit_button_text": "Send",
      "customer_notification_template_id": "241",
      "description": "<h1>Withdrawal of your order</h1>\r\n<p>Use this form to return, change or cancel your order. Select what you would like to do below and complete the relevant details.</p>\r\n<p><strong>Explanation:</strong></p>\r\n<ul>\r\n<li><strong>Return</strong> – you have received the order and want to return (part of) it.</li>\r\n<li><strong>Change</strong> – you have not yet received the order and want to change a part.</li>\r\n<li><strong>Cancel</strong> – you have not yet received the order and want to cancel (part of) it.</li>\r\n</ul>",
      "success_text": "<p>Thank you for completing the form.</p> <p>Tuinmaximaal will contact you as soon as possible.</p>"
    }
  },
